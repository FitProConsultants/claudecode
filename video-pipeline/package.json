{
  "name": "video-pipeline",
  "version": "1.0.0",
  "description": "Automated video editing pipeline: raw footage → polished Reels or YouTube video",
  "type": "module",
  "scripts": {
    "pipeline": "tsx src/pipeline/index.ts",
    "preview": "remotion studio src/remotion-root.tsx",
    "render:reels": "remotion render src/remotion-root.tsx Reels --output=output/reels.mp4",
    "render:youtube": "remotion render src/remotion-root.tsx YouTube --output=output/youtube.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@remotion/bundler": "^4.0.290",
    "@remotion/cli": "^4.0.290",
    "@remotion/renderer": "^4.0.290",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "openai": "^4.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.290"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
